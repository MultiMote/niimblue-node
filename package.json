{
  "name": "@mmote/niimblue-node",
  "version": "1.4.0",
  "description": "niimbluelib command line interface, simple REST server",
  "keywords": [
    "command-line",
    "thermal-printer",
    "label-printer",
    "niimbot",
    "niimbot-d110",
    "niimbot-b1",
    "niimbot-b21",
    "bluetooth",
    "serial"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MultiMote/niimblue-node.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "bin": {
    "niimblue-cli": "./cli.mjs"
  },
  "author": "MultiMote",
  "license": "MIT",
  "private": false,
  "scripts": {
    "clean-build": "yarn clean && yarn build",
    "build": "tsc --build",
    "cli": "tsc --build && node cli.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^12.1.0",
    "@mmote/niimbluelib": "0.47.0-node",
    "async-mutex": "^0.5.0",
    "commander": "^12.1.0",
    "sharp": "^0.35.3",
    "zod": "^3.25.76"
  },
  "allowScripts": {
    "sharp": true,
    "usb": true,
    "@serialport/bindings-cpp": true,
    "@stoprocent/bluetooth-hci-socket": true,
    "@stoprocent/noble": true
  }
}
